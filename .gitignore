# OS artifacts
.DS_Store

# Local environment files
.env.local

# Data files (large CSVs, Excel, filtered output)
data/*
!data/knowledge/
!data/mock_business_exports/

# claude env files
.claude/

# Python
__pycache__/
*.pyc

# Compiled class file
*.class

# Maven build output (codex 2026-05-03 round 3 §1.7 / §5.8 — never commit)
target/
*.jar.original

# Eval run artifacts — regenerated per run; keep the directory via .gitkeep
eval_interactive/results/*
!eval_interactive/results/.gitkeep

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

#ultrareview/compare 工具的临时输出
.compare-output/

